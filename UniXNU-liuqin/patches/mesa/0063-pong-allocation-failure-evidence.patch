+/* Bounded failure evidence, by stage, without logging successful BO traffic. */
+static bool
+darwin_log_failure(unsigned stage)
+{
+   static unsigned reports[5];
+   return stage < 5 && __atomic_fetch_add(&reports[stage], 1, __ATOMIC_RELAXED) < 16;
+}
+
+static VkResult darwin_device_lost(struct vk_device *device, const char *format, ...)
+   __attribute__((format(printf, 2, 3)));
+static VkResult
+darwin_device_lost(struct vk_device *device, const char *format, ...)
+{
+   char message[512];
+   va_list args;
+   va_start(args, format);
+   vsnprintf(message, sizeof(message), format, args);
+   va_end(args);
+   if (darwin_log_failure(4))
+      fprintf(stderr, "Pong Turnip device-lost: pid=%d %s\n", getpid(), message);
+   return vk_device_set_lost(device, "%s", message);
+}
