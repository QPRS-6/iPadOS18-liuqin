+++ b/osfmk/kern/pong_fb_affinity.h
@@ -0,0 +1,173 @@
+/* SPDX-License-Identifier: MIT
+ * Optional liuqin/SM8475 display-worker binding, fb_mid=1 with fb_threads=3.
+ * Mach-private implementation; IOKit calls only pong_fb_worker_prepare().
+ * CPU identity comes from ArmCpu's per-CPU MIDR reads, not an assumed ID mask.
+ */
+#pragma once
+#include <kern/processor.h>
+#include <kern/sched_prim.h>
+#include <kern/thread.h>
+#include <machine/machine_routines.h>
+
+extern uint32_t pong_cpu_midr(unsigned cpu);
+void pong_fb_worker_prepare(unsigned worker, unsigned workers);
+static TUNABLE(uint32_t, gFBMiddle, "fb_mid", 0);
+
+typedef enum { kPongFBUntried, kPongFBBound, kPongFBSkipped, kPongFBFailed } PongFBBindState;
+typedef struct {
+	thread_t thread;
+	processor_t processor;
+	int cpu;
+	uint32_t midr;
+	PongFBBindState state, reported;
+	const char *reason;
+	uint64_t jobs;
+} PongFBBinding;
+/* Permanent kernel workers, like the existing framebuffer threads themselves.
+ * All slot access is serialized with CPU exit by processor_updown_lock. */
+static PongFBBinding gFBBindings[3];
+
+static bool
+pongFBIsMiddle(uint32_t midr)
+{
+	/* ARM implementer, architectural MIDR format, Cortex-A710 part. */
+	return (midr & 0xff0ffff0u) == 0x410fd470u;
+}
+
+static int
+pongFBMiddleCpu(const uint32_t *midrs, unsigned count, unsigned worker, unsigned workers)
+{
+	if (count > 8 || workers != 3 || worker >= workers) return -1;
+	unsigned found = 0;
+	int selected = -1;
+	for (unsigned cpu = 0; cpu < count; cpu++) {
+		if (!pongFBIsMiddle(midrs[cpu])) continue;
+		if (found == worker) selected = (int)cpu;
+		found++;
+	}
+	/* Refuse a partial or different topology instead of aliasing two workers. */
+	return found == 3 ? selected : -1;
+}
+
+static bool
+pongFBProcessorEligible(processor_t processor)
+{
+	/* Caller holds processor_updown_lock, also excluding shutdown-in-progress. */
+	if (processor == PROCESSOR_NULL || !processor->processor_booted ||
+	    processor->cpu_id < 0 || processor->cpu_id >= 8) return false;
+	processor_set_t pset = processor->processor_set;
+	if (pset == PROCESSOR_SET_NULL) return false;
+	spl_t s = splsched();
+	pset_lock(pset);
+	const uint64_t bit = 1ULL << processor->cpu_id;
+	bool eligible = processor->state >= PROCESSOR_IDLE && processor->state <= PROCESSOR_RUNNING &&
+	    !processor->processor_inshutdown && processor->is_recommended &&
+	    (pset->cpu_bitmask & pset->cpu_available_map & pset->recommended_bitmask & bit) != 0;
+	pset_unlock(pset);
+	splx(s);
+	return eligible;
+}
+
+typedef struct { int cpu; uint32_t midr; uint64_t mpidr; } PongFBCpuSample;
+static PongFBCpuSample
+pongFBCpuNow(void)
+{
+	/* Keep logical ID and both architectural register reads on the same CPU. */
+	disable_preemption();
+	int cpu = (int)ml_get_cpu_number_local();
+	uint64_t midr, mpidr;
+	__asm__ volatile("mrs %0, midr_el1" : "=r"(midr));
+	__asm__ volatile("mrs %0, mpidr_el1" : "=r"(mpidr));
+	enable_preemption();
+	return (PongFBCpuSample){cpu, (uint32_t)midr, mpidr};
+}
+
+void
+pong_fb_worker_prepare(unsigned worker, unsigned workers)
+{
+	if (gFBMiddle != 1 || worker >= 3) return;
+	/* No fLock, fSwapLock or fHelperLock held. In particular, migration must
+	 * not hold a lock the other row workers need to finish the current layer. */
+	lck_mtx_lock(&processor_updown_lock);
+	PongFBBinding *slot = &gFBBindings[worker];
+	thread_t self = current_thread();
+	if (slot->thread != THREAD_NULL && slot->thread != self) {
+		lck_mtx_unlock(&processor_updown_lock);
+		return; /* another framebuffer cannot replace an existing worker */
+	}
+	if (slot->state == kPongFBUntried) {
+		slot->thread = self;
+		thread_reference(self);
+		slot->state = kPongFBSkipped;
+		slot->reason = "identity-or-worker-count";
+		uint32_t midrs[8];
+		for (unsigned cpu = 0; cpu < 8; cpu++) midrs[cpu] = pong_cpu_midr(cpu);
+		slot->cpu = pongFBMiddleCpu(midrs, 8, worker, workers);
+		if (slot->cpu >= 0) {
+			slot->midr = midrs[slot->cpu];
+			slot->processor = cpu_to_processor(slot->cpu);
+			slot->reason = "cpu-not-eligible";
+			if (pongFBProcessorEligible(slot->processor)) {
+				spl_t s = splsched();
+				thread_lock(self);
+				bool bindable = self->bound_processor == PROCESSOR_NULL && self->sched_pri < BASEPRI_RTQUEUES;
+				thread_unlock(self);
+				splx(s);
+				slot->reason = "existing-binding-or-realtime";
+				if (bindable) {
+					/* The CPU-exit hook takes this same mutex before offlining;
+					 * keep it until thread_block has completed the migration. */
+					processor_t previous = thread_bind(slot->processor);
+					if (previous == PROCESSOR_NULL) {
+						slot->state = kPongFBBound;
+						slot->reason = "middle-core";
+						thread_block(THREAD_CONTINUE_NULL);
+					} else {
+						thread_bind(previous);
+					}
+				}
+			}
+		}
+	}
+	if (slot->state == kPongFBBound && (workers != 3 || !pongFBProcessorEligible(slot->processor))) {
+		thread_bind(PROCESSOR_NULL);
+		slot->state = kPongFBSkipped;
+		slot->reason = "cpu-no-longer-eligible";
+	}
+	PongFBCpuSample observed = pongFBCpuNow();
+	if (slot->state == kPongFBBound && (observed.cpu != slot->cpu || observed.midr != slot->midr)) {
+		thread_bind(PROCESSOR_NULL);
+		slot->state = kPongFBFailed;
+		slot->reason = "migration-identity-mismatch";
+	}
+	/* Three samples plus at most one fallback per worker, no per-frame log. */
+	uint64_t jobs = ++slot->jobs;
+	bool report = slot->reported != slot->state || (slot->state == kPongFBBound && (jobs == 128 || jobs == 1024));
+	slot->reported = slot->state;
+	PongFBBindState state = slot->state;
+	const char *reason = slot->reason;
+	int target = slot->cpu;
+	lck_mtx_unlock(&processor_updown_lock);
+	if (report) printf("Pong FB affinity: %s worker=%u target=%d actual=%d MIDR=%#x MPIDR=%#llx jobs=%llu reason=%s\n",
+	    state == kPongFBBound ? "PASS" : state == kPongFBFailed ? "FAIL" : "SKIP",
+	    worker, target, observed.cpu, observed.midr, observed.mpidr, jobs, reason);
+}
+
+/* processor_doshutdown invokes this while holding processor_updown_lock,
+ * before setting processor_inshutdown or removing the CPU from scheduling.
+ * Plain thread_bind has no offline fallback: detach only our registered
+ * workers, including sleeping, runnable and preempted workers. This hook
+ * performs no allocation, framebuffer locking, logging or hardware access. */
+static void
+pong_fb_cpu_exit(processor_t processor)
+{
+	for (unsigned worker = 0; worker < 3; worker++) {
+		PongFBBinding *slot = &gFBBindings[worker];
+		if (slot->state != kPongFBBound || slot->processor != processor) continue;
+		spl_t s = splsched();
+		thread_unbind_after_queue_shutdown(slot->thread, processor);
+		splx(s);
+		slot->state = kPongFBSkipped;
+		slot->reason = "cpu-exit-unbound";
+	}
+}
