 static uint32_t bb_spin_per_us = 60;    /* calibrated at bring-up */
+/* Observation only: do not mask interrupts, change SPI pacing or schedule
+ * synthetic work. Byte timing is enabled only while a report owns SPI. */
+static bool tch_bb_time_report;
+static uint64_t tch_bb_max_byte_abs;
+struct tch_report_time { uint64_t id, end_us, total_us, byte_us; };
+static struct tch_report_time tch_report_time_current; /* report thread only */
+static uint64_t tch_report_time_id;
+struct tch_report_timing {
+	struct tch_report_time last, good, first_fd;
+	uint64_t max_total_us, max_byte_us;
+	bool watchdog;
+};
+static struct tch_report_timing tch_report_timings;
+static unsigned tch_timing_owner, tch_timing_skips;
+
+static void
+tch_record_report_timing(bool good, bool watchdog)
+{
+	unsigned expected = 0;
+	/* Diagnostics must never wait on a preempted snapshot reader. */
+	if (!__atomic_compare_exchange_n(&tch_timing_owner, &expected, 1, false,
+	    __ATOMIC_ACQUIRE, __ATOMIC_RELAXED)) {
+		(void)__atomic_add_fetch(&tch_timing_skips, 1, __ATOMIC_RELAXED);
+		return;
+	}
+	struct tch_report_timing *t = &tch_report_timings;
+	t->last = tch_report_time_current;
+	if (good) t->good = t->last;
+	if (watchdog && !t->watchdog) t->first_fd = t->last;
+	t->watchdog = watchdog;
+	if (t->last.total_us > t->max_total_us) t->max_total_us = t->last.total_us;
+	if (t->last.byte_us > t->max_byte_us) t->max_byte_us = t->last.byte_us;
+	__atomic_store_n(&tch_timing_owner, 0, __ATOMIC_RELEASE);
+}
 
