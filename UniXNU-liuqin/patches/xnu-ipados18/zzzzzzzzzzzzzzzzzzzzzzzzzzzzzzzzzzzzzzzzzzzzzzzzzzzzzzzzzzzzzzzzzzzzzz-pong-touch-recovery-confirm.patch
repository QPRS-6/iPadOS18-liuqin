+/* Recovery completion needs a real report, not just RESET_COMPLETE=0xa0.
+ * Count a bounded, in-range contact or the normal all-FF empty record area.
+ * The boot placeholder FF/00 and the FD/FE watchdog fill confirm neither. */
+static unsigned tch_good_reports;
+static unsigned tch_watchdog_report;
+
+static void
+tch_report_health(const uint8_t *frame)
+{
+	bool healthy = false, empty = true, watchdog = true;
+	for (unsigned i = 0; i < 6; i++) {
+		if (frame[i] != 0xfd && frame[i] != 0xfe) watchdog = false;
+	}
+	for (int i = 0; i < NVT_MAX_FINGERS; i++) {
+		const unsigned id = tch_rec_id(frame, i), event = tch_rec_event(frame, i);
+		if (id >= 1 && id <= NVT_MAX_FINGERS && (event == 1 || event == 2) &&
+		    tch_rec_x(frame, i) <= tch.max_x && tch_rec_y(frame, i) <= tch.max_y)
+			healthy = true;
+	}
+	for (unsigned i = 0; i < 6 * NVT_MAX_FINGERS; i++) {
+		if (frame[i] != 0xff) { empty = false; break; }
+	}
+	__atomic_store_n(&tch_watchdog_report, watchdog, __ATOMIC_RELEASE);
+	if (healthy || empty)
+		(void)__atomic_add_fetch(&tch_good_reports, 1, __ATOMIC_RELEASE);
+}
 
