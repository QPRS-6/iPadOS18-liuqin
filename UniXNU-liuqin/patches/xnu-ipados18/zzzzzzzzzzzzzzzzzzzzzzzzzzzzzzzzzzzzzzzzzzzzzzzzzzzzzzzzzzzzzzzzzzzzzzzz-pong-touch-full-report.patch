+/* The liuqin vendor calls CTP_SPI_READ with 109 bytes including the
+ * address byte. Its helper clocks one extra dummy and copies length-1
+ * data bytes from RX+2: consume all 108 report bytes in ONE transaction.
+ * Only the existing 65-byte touch prefix is decoded; no stylus input is
+ * fabricated. A short prefix read does not match the vendor wire contract. */
+static int
+tch_read_report(uint8_t *frame)
+{
+	uint8_t report[NVT_EVENT_BLOCK_LEN - 1];
+	_Static_assert(sizeof(report) >= NVT_POINT_LEN, "report must contain the touch prefix");
+	const int err = tch_nvt_read(NVT_EVENT_BUF_ADDR, report, sizeof(report));
+	if (err == 0) memcpy(frame, report, NVT_POINT_LEN);
+	return err;
+}
