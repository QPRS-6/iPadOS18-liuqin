@@ -148,6 +148,58 @@
 
 void panic_with_thread_kernel_state(const char *msg, arm_saved_state_t *ss) __abortlike;
 
+#if defined(PONG) && (DEVELOPMENT || DEBUG)
+/*
+ * Bounded user-fault records.  Printing from the exception path deadlocked the
+ * kernel log lock on this port (spinlock timeout panic at the first user fault),
+ * so the handler only appends to a static array; the record is flushed later
+ * from the exiting process' own thread, where printing is safe.
+ */
+#define PONG_USER_FAULT_SLOTS 16
+struct pong_user_fault_record {
+	int      pid;
+	uint64_t pc, lr, far, esr;
+};
+static struct pong_user_fault_record pong_user_fault_records[PONG_USER_FAULT_SLOTS];
+static unsigned pong_user_fault_count;
+
+void
+pong_user_fault_note(int pid, uint64_t pc, uint64_t lr, uint64_t far, uint64_t esr)
+{
+	unsigned slot = __atomic_fetch_add(&pong_user_fault_count, 1u, __ATOMIC_RELAXED);
+
+	if (slot >= PONG_USER_FAULT_SLOTS) {
+		return;
+	}
+	pong_user_fault_records[slot].pid = pid;
+	pong_user_fault_records[slot].pc  = pc;
+	pong_user_fault_records[slot].lr  = lr;
+	pong_user_fault_records[slot].far = far;
+	pong_user_fault_records[slot].esr = esr;
+}
+
+void
+pong_user_fault_dump(int pid)
+{
+	unsigned i, n = __atomic_load_n(&pong_user_fault_count, __ATOMIC_RELAXED);
+
+	if (n > PONG_USER_FAULT_SLOTS) {
+		n = PONG_USER_FAULT_SLOTS;
+	}
+	for (i = 0; i < n; i++) {
+		if (pong_user_fault_records[i].pid != pid) {
+			continue;
+		}
+		printf("PONG UFAULT pid=%d pc=%#llx lr=%#llx far=%#llx esr=%#llx\n",
+		    pid,
+		    (unsigned long long)pong_user_fault_records[i].pc,
+		    (unsigned long long)pong_user_fault_records[i].lr,
+		    (unsigned long long)pong_user_fault_records[i].far,
+		    (unsigned long long)pong_user_fault_records[i].esr);
+	}
+}
+#endif
+
