+#[test]
+fn addressed_fallback_releases_failed_buffers_and_binds_only_actual_capacity() {
+    let a = Allocator::new(&[(vk::MemoryPropertyFlags::DEVICE_LOCAL, 0)], true);
+    let counts = Counters::default();
+    let addressed = |size| {
+        memory::allocate_addressed(
+            &a.memory,
+            &a.device,
+            &requirements(size, 1),
+            MemoryClass::Private,
+            &counts,
+        )
+    };
+    let _first = addressed(32 * MIB).unwrap();
+    let _second = addressed(32 * MIB).unwrap();
+    DRIVER.with_borrow_mut(|d| d.largest = 12_697_600);
+    let small = addressed(4096).unwrap();
+    assert!(small.address.unwrap() > u64::from(u32::MAX));
+    DRIVER.with_borrow(|d| assert_eq!(d.buffers.len(), 3));
+    a.memory.lock().unwrap().free(&a.device, &small);
+    DRIVER.with_borrow(|d| {
+        assert_eq!(d.buffers.len(), 2);
+        assert_eq!(d.live.len(), 2);
+    });
+}
