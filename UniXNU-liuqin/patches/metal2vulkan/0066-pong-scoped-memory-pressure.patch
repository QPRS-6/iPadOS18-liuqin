+#[test]
+fn speculative_blocks_follow_the_advertised_heap_not_system_ram() {
+    for (heap_mib, block_mib) in [(128, 8), (256, 16), (512, 32), (1280, 64)] {
+        let a = Allocator::with_heap_sizes(
+            &[(vk::MemoryPropertyFlags::DEVICE_LOCAL, 0)],
+            false,
+            &[heap_mib * MIB],
