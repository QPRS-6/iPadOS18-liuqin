+        for _ in 0..10 {
+            a.buffer(block_mib * MIB / 2, 1).unwrap();
+        }
+        DRIVER.with_borrow(|d| {
+            assert_eq!(
+                d.attempts.iter().map(|(bytes, _)| *bytes).max(),
+                Some(block_mib * MIB)
+            );
+        });
+    }
+}
