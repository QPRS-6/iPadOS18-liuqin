+#[test]
+fn a_host_import_can_reclaim_idle_pooled_memory_on_its_heap() {
+    #[repr(align(4096))]
+    struct Pages([u8; 8192]);
+    let mut pages = Box::new(Pages([0; 8192]));
+    let host = vk::MemoryPropertyFlags::HOST_VISIBLE | vk::MemoryPropertyFlags::HOST_COHERENT;
+    let a = Allocator::new(
+        &[(vk::MemoryPropertyFlags::DEVICE_LOCAL, 0), (host, 0)],
+        false,
+    );
+    DRIVER.with_borrow_mut(|d| d.heaps[0] = 8 * MIB);
+    let idle = a.buffer(8 * MIB, 1).unwrap();
+    let mut memory = a.memory.lock().unwrap();
+    memory.free(&a.device, &idle);
+    // SAFETY: aligned, owned pages stay alive until the import is freed below.
+    let imported = unsafe {
+        memory.import_host(
+            &a.device,
+            (NonNull::new(pages.0.as_mut_ptr()).unwrap(), None),
+            8192,
+            2,
+            MemoryClass::Shared,
+        )
+    }
+    .expect("an import participates in the same heap's pressure reclamation");
+    assert_eq!(imported.mapped.unwrap().as_ptr(), pages.0.as_mut_ptr());
+    DRIVER.with_borrow(|d| assert_eq!(d.freed, [idle.memory.as_raw()]));
+    memory.free(&a.device, &imported);
+}
