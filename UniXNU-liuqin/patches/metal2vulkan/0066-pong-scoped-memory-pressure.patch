 pub(super) const BLOCK_BYTES: u64 = 64 << 20;
+
+/// Bound speculative pooling by the memory the device actually exposes, which can be a scoped
+/// GPU address window rather than all system RAM. Each pool may keep both live and empty blocks;
+/// no single growth block takes more than a sixteenth of the smallest advertised usable heap.
+/// Missing heap facts leave the ordinary cap; required resources are not limited by this cap.
+fn scoped_block_bytes(properties: &vk::PhysicalDeviceMemoryProperties, max_allocation: u64) -> u64 {
+    let count = (properties.memory_type_count as usize).min(vk::MAX_MEMORY_TYPES);
+    let heap_count = (properties.memory_heap_count as usize).min(vk::MAX_MEMORY_HEAPS);
+    let heap_bytes = properties.memory_types[..count]
+        .iter()
+        .filter(|ty| allocatable(ty.property_flags))
+        .filter_map(|ty| properties.memory_heaps[..heap_count].get(ty.heap_index as usize))
+        .map(|heap| heap.size)
+        .filter(|&size| size != 0)
+        .min()
+        .unwrap_or(BLOCK_BYTES * 16);
+    BLOCK_BYTES
+        .min((heap_bytes / 16).max(4096))
+        .min(max_allocation.max(1))
+}
 
