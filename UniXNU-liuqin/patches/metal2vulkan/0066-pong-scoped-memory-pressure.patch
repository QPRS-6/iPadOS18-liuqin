+//! The real allocator against a bounded Vulkan allocation table. No GPU is opened.
+use crate::error::{Error, MemoryKind};
+use crate::memory::{self, Memory, MemoryClass};
+use crate::work_counts::Counters;
+use ash::vk::{self, Handle};
+use std::cell::RefCell;
+use std::collections::BTreeMap;
+use std::ffi::c_void;
+use std::ptr::NonNull;
+use std::sync::Mutex;
+
+const MIB: u64 = 1 << 20;
+
+struct Driver {
+    next: u64,
+    heaps: [u64; 2],
+    used: [u64; 2],
+    type_heaps: Vec<usize>,
+    largest: u64,
+    fail_next: Option<vk::Result>,
+    attempts: Vec<(u64, u32)>,
+    live: BTreeMap<u64, (u64, usize)>,
+    buffers: BTreeMap<u64, (u64, Option<u64>)>,
+    freed: Vec<u64>,
+}
+
+impl Default for Driver {
+    fn default() -> Self {
+        Self {
+            next: 1,
+            heaps: [256 * MIB; 2],
+            used: [0; 2],
+            type_heaps: vec![0],
+            largest: u64::MAX,
+            fail_next: None,
+            attempts: Vec::new(),
+            live: BTreeMap::new(),
+            buffers: BTreeMap::new(),
+            freed: Vec::new(),
+        }
+    }
+}
+
+thread_local! {
+    static DRIVER: RefCell<Driver> = RefCell::new(Driver::default());
+}
+
+unsafe extern "system" fn allocate(
+    _: vk::Device,
+    info: *const vk::MemoryAllocateInfo<'_>,
+    _: *const vk::AllocationCallbacks<'_>,
+    out: *mut vk::DeviceMemory,
+) -> vk::Result {
+    // SAFETY: ash passes a live allocation info and one writable output handle.
+    let info = unsafe { &*info };
+    DRIVER.with_borrow_mut(|d| {
+        d.attempts
+            .push((info.allocation_size, info.memory_type_index));
+        if let Some(error) = d.fail_next.take() {
+            return error;
+        }
+        let heap = d.type_heaps[info.memory_type_index as usize];
+        let size = info.allocation_size;
+        if size > d.largest || size > d.heaps[heap].saturating_sub(d.used[heap]) {
+            return vk::Result::ERROR_OUT_OF_DEVICE_MEMORY;
+        }
+        let id = d.next;
+        d.next += 1;
+        d.used[heap] += size;
+        assert!(d.live.insert(id, (size, heap)).is_none());
+        // SAFETY: the caller's writable handle, only published on success.
+        unsafe { out.write(vk::DeviceMemory::from_raw(id)) };
+        vk::Result::SUCCESS
+    })
+}
+
+unsafe extern "system" fn free(
+    _: vk::Device,
+    memory: vk::DeviceMemory,
+    _: *const vk::AllocationCallbacks<'_>,
+) {
+    DRIVER.with_borrow_mut(|d| {
+        let id = memory.as_raw();
+        assert!(d.buffers.values().all(|(_, bound)| *bound != Some(id)));
+        let (size, heap) = d.live.remove(&id).expect("memory freed once");
+        d.used[heap] -= size;
+        d.freed.push(id);
+    });
+}
+
+unsafe extern "system" fn create_buffer(
+    _: vk::Device,
+    info: *const vk::BufferCreateInfo<'_>,
+    _: *const vk::AllocationCallbacks<'_>,
+    out: *mut vk::Buffer,
+) -> vk::Result {
+    // SAFETY: ash passes a live create info and a writable output handle.
+    let size = unsafe { (*info).size };
+    DRIVER.with_borrow_mut(|d| {
+        let id = d.next;
+        d.next += 1;
+        assert!(d.buffers.insert(id, (size, None)).is_none());
+        // SAFETY: the caller's writable handle.
+        unsafe { out.write(vk::Buffer::from_raw(id)) };
+    });
+    vk::Result::SUCCESS
+}
+
+unsafe extern "system" fn destroy_buffer(
+    _: vk::Device,
+    buffer: vk::Buffer,
+    _: *const vk::AllocationCallbacks<'_>,
+) {
+    DRIVER.with_borrow_mut(|d| {
+        assert!(d.buffers.remove(&buffer.as_raw()).is_some());
+    });
+}
+
+unsafe extern "system" fn buffer_requirements(
+    _: vk::Device,
+    buffer: vk::Buffer,
+    out: *mut vk::MemoryRequirements,
+) {
+    DRIVER.with_borrow(|d| {
+        let size = d.buffers[&buffer.as_raw()].0.next_multiple_of(256);
+        // SAFETY: ash passes a writable requirements record.
+        unsafe { out.write(requirements(size, u32::MAX)) };
+    });
+}
+
+unsafe extern "system" fn bind_buffer(
+    _: vk::Device,
+    buffer: vk::Buffer,
+    memory: vk::DeviceMemory,
+    offset: u64,
+) -> vk::Result {
+    DRIVER.with_borrow_mut(|d| {
+        let bytes = d.live[&memory.as_raw()].0;
+        let (size, bound) = d.buffers.get_mut(&buffer.as_raw()).unwrap();
+        assert!(bound.is_none() && offset <= bytes && *size <= bytes - offset);
+        *bound = Some(memory.as_raw());
+    });
+    vk::Result::SUCCESS
+}
+
+unsafe extern "system" fn buffer_address(
+    _: vk::Device,
+    info: *const vk::BufferDeviceAddressInfo<'_>,
+) -> u64 {
+    // SAFETY: ash passes a live address query.
+    let buffer = unsafe { (*info).buffer };
+    DRIVER.with_borrow(|d| {
+        let memory = d.buffers[&buffer.as_raw()]
+            .1
+            .expect("address after binding");
+        0x110000000 + memory * 256 * MIB
+    })
+}
+
+struct Allocator {
+    device: ash::Device,
+    memory: Mutex<Memory>,
+}
+
+impl Allocator {
+    fn new(types: &[(vk::MemoryPropertyFlags, u32)], addressed: bool) -> Self {
+        Self::with_heap_sizes(types, addressed, &[])
+    }
+
+    fn with_heap_sizes(
+        types: &[(vk::MemoryPropertyFlags, u32)],
+        addressed: bool,
+        heaps: &[u64],
+    ) -> Self {
+        let mut properties = vk::PhysicalDeviceMemoryProperties {
+            memory_type_count: types.len() as u32,
+            memory_heap_count: heaps.len() as u32,
+            ..Default::default()
+        };
+        for (out, &size) in properties.memory_heaps.iter_mut().zip(heaps) {
+            *out = vk::MemoryHeap {
+                size,
+                flags: vk::MemoryHeapFlags::DEVICE_LOCAL,
+            };
+        }
+        for (out, &(property_flags, heap_index)) in properties.memory_types.iter_mut().zip(types) {
+            *out = vk::MemoryType {
+                property_flags,
+                heap_index,
+            };
+        }
+        DRIVER.with_borrow_mut(|d| {
+            assert!(d.live.is_empty() && d.buffers.is_empty());
+            *d = Driver {
+                type_heaps: types.iter().map(|(_, heap)| *heap as usize).collect(),
+                ..Driver::default()
+            };
+            for (out, &size) in d.heaps.iter_mut().zip(heaps) {
+                *out = size;
+            }
+        });
+        // SAFETY: only these recording entry points are reached; none submits GPU work.
+        let device = unsafe {
+            ash::Device::load_with(
+                |name| match name.to_bytes() {
+                    b"vkAllocateMemory" => allocate as vk::PFN_vkAllocateMemory as *const c_void,
+                    b"vkFreeMemory" => free as vk::PFN_vkFreeMemory as *const c_void,
+                    b"vkCreateBuffer" => create_buffer as vk::PFN_vkCreateBuffer as *const c_void,
+                    b"vkDestroyBuffer" => {
+                        destroy_buffer as vk::PFN_vkDestroyBuffer as *const c_void
+                    }
+                    b"vkGetBufferMemoryRequirements" => {
+                        buffer_requirements as vk::PFN_vkGetBufferMemoryRequirements
+                            as *const c_void
+                    }
+                    b"vkBindBufferMemory" => {
+                        bind_buffer as vk::PFN_vkBindBufferMemory as *const c_void
+                    }
+                    b"vkGetBufferDeviceAddress" => {
+                        buffer_address as vk::PFN_vkGetBufferDeviceAddress as *const c_void
+                    }
+                    _ => std::ptr::null(),
+                },
+                vk::Device::from_raw(1),
+            )
+        };
+        Self {
+            device,
+            memory: Mutex::new(Memory::new(
+                &properties,
+                64 * MIB,
+                addressed,
+                true,
+                vec![0],
+                None,
+                None,
+            )),
+        }
+    }
+
+    fn buffer(&self, bytes: u64, types: u32) -> Result<memory::Placement, Error> {
+        memory::allocate(
+            &self.memory,
+            &self.device,
+            &requirements(bytes, types),
+            MemoryClass::Private,
+        )
+    }
+}
+
+impl Drop for Allocator {
+    fn drop(&mut self) {
+        // This table has no queue; all allocations are idle at teardown.
+        // A negative baseline assertion may have poisoned the test's lock.
+        // Teardown still owns the table exclusively and must not panic again.
+        drop(
+            self.memory
+                .get_mut()
+                .unwrap_or_else(std::sync::PoisonError::into_inner)
+                .destroy(&self.device),
+        );
+        DRIVER.with_borrow(|d| assert!(d.live.is_empty() && d.buffers.is_empty()));
+    }
+}
