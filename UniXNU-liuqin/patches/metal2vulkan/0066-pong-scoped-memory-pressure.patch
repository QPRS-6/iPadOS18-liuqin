+#[test]
+fn pressure_reclaims_other_types_on_the_same_heap_but_no_live_or_foreign_block() {
+    let flags = vk::MemoryPropertyFlags::DEVICE_LOCAL;
+    let a = Allocator::new(&[(flags, 0), (flags, 0), (flags, 1)], false);
+    DRIVER.with_borrow_mut(|d| d.heaps[0] = 20 * MIB);
+    let live = a.buffer(8 * MIB, 1).unwrap();
+    let idle = a.buffer(8 * MIB, 2).unwrap();
+    let foreign = a.buffer(8 * MIB, 4).unwrap();
+    {
+        let mut memory = a.memory.lock().unwrap();
+        memory.free(&a.device, &idle);
+        memory.free(&a.device, &foreign);
+    }
+    let _needed = a
+        .buffer(8 * MIB, 1)
+        .expect("same-heap idle allocation must give way");
+    DRIVER.with_borrow(|d| {
+        assert_eq!(d.freed, [idle.memory.as_raw()]);
+        assert!(d.live.contains_key(&live.memory.as_raw()));
+        assert!(d.live.contains_key(&foreign.memory.as_raw()));
+    });
+}
