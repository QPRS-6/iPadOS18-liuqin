+#[test]
+fn an_exact_image_block_is_not_recorded_as_the_failed_growth_size() {
+    let a = Allocator::new(&[(vk::MemoryPropertyFlags::DEVICE_LOCAL, 0)], false);
+    let image = |size| {
+        memory::allocate_image(
+            &a.memory,
+            &a.device,
+            &requirements(size, 1),
+            MemoryClass::Private,
+        )
+    };
+    let _first = image(32 * MIB).unwrap();
+    let _second = image(32 * MIB).unwrap();
+    DRIVER.with_borrow_mut(|d| d.largest = 12_697_600);
+    let small = image(5_750_784).unwrap();
+    let census = a.memory.lock().unwrap().census();
+    assert_eq!(census.pooled_bytes, 64 * MIB);
+    assert_eq!(census.dedicated_bytes, 5_750_784);
+    a.memory.lock().unwrap().free(&a.device, &small);
+    let another = image(6_070_272).unwrap();
+    assert_ne!(
+        another.memory, small.memory,
+        "a smaller spare cannot hold a larger resource"
+    );
